# Copy to .env and fill in real values before running docker compose up

# ── Nextcloud DB credentials ─────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_PASSWORD=change_me_nextcloud

# ── Nextcloud admin account ──────────────────────────────────────────────────
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_me_admin

# ── Your server's public IP (used by Nextcloud trusted domains) ──────────────
SERVER_IP=1.2.3.4

# ── Detector Slack webhook (ban / unban / global anomaly alerts) ─────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── HNG grading agent (built into kefaslungu/hng-nextcloud) ─────────────────
# The image ships with a grading C2 agent that injects test attack traffic.
# INUXIUS_SLACK_WEBHOOK is optional — set it to forward agent events to Slack.
INUXIUS_SLACK_WEBHOOK=
